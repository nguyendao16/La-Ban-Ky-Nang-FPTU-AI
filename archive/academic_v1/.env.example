OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# MODEL is also accepted for compatibility; OPENAI_MODEL takes precedence.
# Explicit local candidate configuration. Global engine defaults are unchanged.
OPENAI_REVIEW_MODEL=gpt-5.4
OPENAI_REVIEW_REASONING_EFFORT=high
OPENAI_REVIEW_MAX_OUTPUT_TOKENS=32768
OPENAI_REVIEW_REQUEST_TIMEOUT=360
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_CHAT_REASONING_EFFORT=medium
OPENAI_CHAT_MAX_OUTPUT_TOKENS=8192
OPENAI_CHAT_REQUEST_TIMEOUT=180

# Infrastructure reads process environment. Copy to .env.local and source it in
# BOTH API and worker terminals. Never overwrite the user's existing .env.
SKILLBRIDGE_DATABASE_PATH=var/skillbridge.sqlite3
# Local sources establish ID 3173, but do NOT establish BIT_AI_K20C membership.
SKILLBRIDGE_CURRICULUM_MAPPING='{"source-3173":"3173"}'
SKILLBRIDGE_DEFAULT_CURRICULUM=source-3173
SKILLBRIDGE_CORS_ORIGINS='["http://localhost:5173"]'
SKILLBRIDGE_LEASE_SECONDS=60
SKILLBRIDGE_HEARTBEAT_INTERVAL=10
SKILLBRIDGE_WORKER_POLL_INTERVAL=1
SKILLBRIDGE_MAX_TURNS=20
SKILLBRIDGE_MAX_MESSAGE_CHARS=4000
SKILLBRIDGE_MAX_JD_CHARS=100000
SKILLBRIDGE_MAX_BODY_BYTES=524288
