      "degree_level": "Bachelor",
      "time_allocation": "45h (60 sessions) contact hours + 1h final exam + 104h self-study",
      "pre_requisite": "AIL303m",
      "description": "The course gives students a working understanding of how modern generative AI models work and how to use them well. The course covers foundations and intuition of large language models, diffusion and multimodal models; prompt engineering and evaluation; retrieval-augmented generation (RAG); building applications with model APIs; agents and tool use; customization (prompting, RAG, fine-tuning); failure modes and evaluation; and ethics, safety, and governance. Mathematical internals are deferred to the Deep Learning course; this course stays at the level of intuition while building real, hands-on skill.",
      "studenttasks": "- Students must attend at least 80% of contact slots in order to be accepted to the final examination.\n- Students are responsible for completing all exercises, labs, and the term project given by the instructor, in class or at home, and submitting on time.\n- Use laptop in class only for learning purposes.\n- Promptly access the FU FLM at https://flm.fpt.edu.vn/ for up-to-date course information.\n- Disclose any use of AI tools as required by each assignment, and be able to explain and defend all submitted work.",
      "tools": "- Any modern chat-based AI assistant (free tier acceptable for most labs)\n- Python 3.10+ with Google Colab or Jupyter Notebook\n- A code/text editor (e.g., VS Code)\n- A model API endpoint provided by the instructor for Lab 3 (mock available offline)",
      "scoring_scale": "10",
      "decisionno_mm_dd_yyyy": "968/QĐ-ĐHFPT dated 08/07/2026",
      "isapproved": "True",
      "note": "1) On-going Assessment\n- 2 Labs: 10% (Labs 1-2, each 5%)\n- Progress Test: 10%\n- Project Proposal: 10%\n- Final Project: 30%\n2) 1 Final Exam: 40%\n3) Final Result: 100%\nCompletion Criteria:\n1) Every on-going assessment component > 0\n2) Term Project > 0\n3) Final Exam Score >= 4 & Final Result >= 5",
      "is_scored": "True",
      "minavgmarktopass": "5",
      "isactive": "True",
      "approveddate": "8/7/2026"
    },
